#! /bin/bash
## This script runs (like 'java' does) compiled programs (the result of openjml-compile) that have OpenJML programmatically linked in.

## The directory containing this file, which should be either .../OpenJML21 or the release folder
FILE=$(realpath "$BASH_SOURCE" ) ## realpath needed to resolve symlinks; result is the absolute path to this script file
LOCAL=$(dirname "$FILE") # absolute path of the folder containing this file, which should be either .../OpenJML21 or the release folder

. "$LOCAL/setup-exports"

## Now run the compiled Test program
"$LOCAL/openjml-java" $EXPORTS "$@"

