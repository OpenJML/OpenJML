#!/bin/bash

## It is a convenience script to run the version of 'java' embellished with openjml's runtime libraries
## and perhaps also with the coverage agent

R1=$(realpath "$BASH_SOURCE" ) ## realpath needed to resolve symlinks; R1 will be the path to this file
SRC=$(dirname "$R1") # path of the folder containing this file, which should be either .../OpenJML21 or the release folder

BIN=`echo $SRC/build/*/jdk/bin/java`

. $SRC/setup-exports

##echo "$BIN" $AGENT $EXPORTS "$@"
OPENJML_ROOT="$SRC/../../Solvers" "$BIN" $AGENT $EXPORTS "$@"

