#!/bin/bash

## It is a convenience script to run the version of 'java' embellished with openjml's runtime libraries
## and perhaps also with the coverage agent

FILE=$(realpath "$BASH_SOURCE" ) ## realpath needed to resolve symlinks; result is the absolute path to this script file
INSTALL=$(dirname "$FILE") # absolute path of the folder containing this file, which should be either .../OpenJML21 or the release folder


# mac-setup is needed to fix Mac security complaints, though it is only needed the first time
if [ "$( uname )" = "Darwin" ] ; then
  "${INSTALL}/mac-setup" > /tmp/openjmlsetup 2>&1 ;
fi

export PR=
if [ -n "${PROF+set}" ]; then
  echo SETTING $PR :
  export PR=-agentpath:/Users/davidcok/Desktop/profiler/lib/libasyncProfiler.dylib=start,event=cpu,file=profile.html
fi

## BIN is an absolute path, still might have spaces
if [ -e "$INSTALL/version-info.txt" ]; then
  ## In a release
  BIN="$INSTALL/jdk/bin/java"
  OPENJML_INSTALL="$INSTALL" "$BIN" $PR "$@"
else
  ## In development environment
  BIN=`echo "$INSTALL"/build/*/jdk/bin/java`
  OPENJML_INSTALL="$INSTALL" OPENJML_SOLVERS="$INSTALL/../../Solvers" OPENJML_SPECS="$INSTALL/../../Specs" "$BIN" $PR "$@"
fi

