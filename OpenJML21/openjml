#!/bin/bash

## This script may be executed in either the development environment or in a release
## openjml is the embellished version of javac

## The definition of BIN below presumes that only one development target has been built
## $BASH_SOURCE is the path to the executable as it is written in the command-line that launched the script

FILE=$(realpath "$BASH_SOURCE" ) ## realpath needed to resolve symlinks -- result is the absolute path to this script file
INSTALL=$(dirname "$FILE") # absolute path of the folder containing this file

# mac-setup is needed to fix Mac security complaints, though it is only needed the first time this binary is executed
# mac-setup is in the release files; it must be executed manually for the development environment
if [ "$( uname )" = "Darwin" ] ; then
  "${INSTALL}/mac-setup" > /tmp/openjmlsetup 2>&1 ;
fi

export PR=
if [ -n "${PROF+set}" ]; then
  export PR=-J-agentpath:/Users/davidcok/Desktop/profiler/lib/libasyncProfiler.dylib=start,event=cpu,file=profile.html
fi

## BIN is an absolute path, still might have spaces
if [ -e "$INSTALL/version-info.txt" ]; then
  ## In a release
  BIN="$INSTALL"/jdk/bin/javac
  OPENJML_INSTALL="$INSTALL" "$BIN" $PR "$@"
else
  ## In development environment
  BIN=`echo "$INSTALL"/build/*/jdk/bin/javac`
  OPENJML_INSTALL="$INSTALL" OPENJML_SOLVERS="$INSTALL/../../Solvers" OPENJML_SPECS="$INSTALL/../../Specs" "$BIN" $PR "$@"
fi

