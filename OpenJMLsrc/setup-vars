# Keep in sync with setup-vars.bat (Windows CMD equivalent).
# A sourced script that is shared between openjml and openjml-java

## Uses $INSTALL
## Sets BINJAVA BINJAVAC OPENJML_INSTALL OPENJML_SOLVERS OPENJML_SPECS

if [ "$0" = "$BASH_SOURCE" ]; then
    echo "Error: setup-vars script must be sourced"
    exit 1
fi

# if OPENJML_INSTALL is not set, then set and export it; otherwise just export the current value
if [ -z ${OPENJML_INSTALL++} ]; then export OPENJML_INSTALL="$INSTALL" ; else export OPENJML_INSTALL ; fi


## set BINJAVA, BINJAVAC and other vars -- if those others are already set, then export them
## BINJAVA and BINJAVAC are an absolute path, still might have spaces

## On Windows (WSL) the JDK binaries have a .exe suffix; detect this once
if [ -n "$(grep -si microsoft /proc/version 2>/dev/null)" ]; then EXE=".exe" ; else EXE="" ; fi

if [ -e "$INSTALL/version-info.txt" ]; then
  ## In a release
  if [ -n ${OPENJML_SOLVERS++} ]; then export OPENJML_SOLVERS ; fi
  if [ -n ${OPENJML_SPECS++} ]; then export OPENJML_SPECS ; fi
  ## On WSL, Windows PE java.exe cannot see Linux env vars directly.
  ## Set OPENJML_SPECS/OPENJML_SOLVERS here so they can be path-translated by WSLENV below.
  if [ -n "$EXE" ]; then
    if [ -z ${OPENJML_SPECS++} ];   then export OPENJML_SPECS="$INSTALL/specs"            ; fi
    if [ -z ${OPENJML_SOLVERS++} ]; then export OPENJML_SOLVERS="$INSTALL" ; fi
  fi
  BINJAVA="$INSTALL/jdk/bin/java$EXE"
  BINJAVAC="$INSTALL/jdk/bin/javac$EXE"
else
  ## In development environment
  if [ -z ${OPENJML_SOLVERS++} ]; then export OPENJML_SOLVERS=$(realpath "$INSTALL"/../../Solvers) ; else export OPENJML_SOLVERS ; fi
  if [ -z ${OPENJML_SPECS++} ]; then export OPENJML_SPECS=$(realpath "$INSTALL"/../../Specs/specs) ; else export OPENJML_SPECS ; fi
  BINJAVA=`echo "$INSTALL"/build/*/jdk/bin/java$EXE`
  BINJAVAC=`echo "$INSTALL"/build/*/jdk/bin/javac$EXE`
fi

## On WSL: forward OPENJML path vars to Windows PE processes (java.exe/javac.exe),
## translating Unix paths to Windows format via the WSLENV /p flag.
## Without this, System.getenv() returns null for these vars in Windows PE processes.
if [ -n "$EXE" ]; then
  export WSLENV="${WSLENV:+$WSLENV:}OPENJML_INSTALL/p:OPENJML_SPECS/p:OPENJML_SOLVERS/p"
fi
