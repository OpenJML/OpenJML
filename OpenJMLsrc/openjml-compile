#! /usr/bin/env bash

## Keep in sync with openjml-compile.bat (Windows CMD equivalent).
## This script runs the basic openjml compilation/esc/rac tool, but with the options that permit linking in 
## openjdk/openjml code for programmatic access to openjdk/openjml. It is analogous to javac.

## This script may be executed within the development environment or in a release

## Directory containing this file, which should be either .../OpenJMLsrc or the release folder
FILE=$(realpath "$BASH_SOURCE" ) ## realpath needed to resolve symlinks -- result is the path to this script file
INSTALL=$(dirname "$FILE") # path of the folder containing this file

## Detect platform: set path separator (PS) and path converter (conv).
## In WSL and native Windows shells, javac is a Windows .exe that needs Windows-format
## paths and ; as the path-list separator.  On macOS/Linux, : and native paths are used.
if [ -n "$(grep -si microsoft /proc/version 2>/dev/null)" ]; then
    PS=";" ; conv() { wslpath -w "$1"; }
else
    case "$(uname -s)" in
        CYGWIN*|MINGW*|MSYS*) PS=";" ; conv() { cygpath -w "$1"; } ;;
        *)                     PS=":" ; conv() { printf '%s' "$1"; } ;;
    esac
fi

if [ -e "$INSTALL/version-info.txt" ]; then
  ## In a release
  MODULES=$(conv "$INSTALL/jdk/modules")
  CL=$(for d in "$INSTALL"/jdk/modules/*/; do printf '%s%s' "$PS" "$(conv "${d%/}")"; done | cut -c2-)
else
  ## In development environment
  MODULES=$(conv "$(echo "$INSTALL"/build/*release/jdk/modules)")
  CL=$(for d in "$INSTALL"/build/*/jdk/modules/*/; do printf '%s%s' "$PS" "$(conv "${d%/}")"; done | cut -c2-)
fi

CP=".${PS}${CL}"

. "${INSTALL}/setup-exports"

"${INSTALL}/openjml" -cp "$CP" -p "$MODULES" $OPENJML_EXPORTS --compile "$@"

