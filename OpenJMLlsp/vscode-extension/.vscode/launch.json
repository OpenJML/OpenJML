{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch OpenJML Extension",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}"
            ],
            "env": {
                "OPENJML_SERVER_PATH": "${workspaceFolder}/../openjml-lsp"
            }
        }
    ]
}
