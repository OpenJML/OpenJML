java -classpath "rac${Z}${RT}" -Dorg.jmlspecs.openjml.rac=stdout A 1 2 > racactual 2> racstderr
tr -d '\r' < racactual | sed -e 'sx\\x/xg' |  diff - ../releaseTests/testRac/expected-simple || { RES=$(($RES+1)); }
diff racstderr ../releaseTests/testRac/expected-empty  || { RES=$(($RES+1)); }
echo RAC-EXC
java -classpath "rac${Z}${RT}" -Dorg.jmlspecs.openjml.rac=exception A 1 2 > racactual  2> racstderr
tr -d '\r' < racactual | sed -e 'sx\\x/xg' |  diff - ../releaseTests/testRac/expected-start || { RES=$(($RES+1)); }
diff racstderr ../releaseTests/testRac/expected-exceptions  || { RES=$(($RES+1)); }
echo RAC-JA
java -classpath "rac${Z}${RT}" -Dorg.jmlspecs.openjml.rac=javaassert A 1 2 > racactual  2> racstderr
tr -d '\r' < racactual | sed -e 'sx\\x/xg' |  diff - ../releaseTests/testRac/expected-javaassert || { RES=$(($RES+1)); }
diff racstderr ../releaseTests/testRac/expected-empty  || { RES=$(($RES+1)); }
