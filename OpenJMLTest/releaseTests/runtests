#! /usr/bin/env bash

## Folder containing this script -- which is OpenJMLTest/releaseTests
LOCAL=`cd $(dirname $BASH_SOURCE[0]) && pwd`

## This file tests a release of the OpenJML tool
## This is just a quick "smoke" test to make sure that 
## the tool runs on simple inputs
## It is intended to be run with the OpenJML project directory as its 
## current working directory, but does its work in a temporary subdirectory

Z=:
if [[ "$COMSPEC" != "" ]] ; then
Z=';'
fi

## Source the file that sets OPENJML_JVM, if requested because COV is set
. $LOCAL/../setup-coverage releasetests


if [ -z "${ZIPARCHIVE+x}" ]; then
  ## if ZIPARCHIVE is not set, then test the current build in development environment holding this file
  export OJBIN="$LOCAL/../../OpenJMLsrc"
  OJ="$OJBIN"/openjml
  JV="$OJBIN"/openjml-java
  RT="$OJBIN"/jmlruntime.jar
  echo "Testing current build at $OJ"

else
  if [ -z "${ZIPARCHIVE}" ]; then
    ## ZIPARCHIVE is set to an empty string -- use default
    ZIPARCHIVE=$LOCAL/../../OpenJMLsrc/release-temp/openjml.zip
  fi
  ## ZIPARCHIVE is set -- presume it names an openjml.zip to be tested
  if [ ! -e "$ZIPARCHIVE" ]; then
    echo "Zip file not found" $ZIPARCHIVE "cwd=" `pwd` 
    exit 1
  fi
  
  rm -rf temp-release
  mkdir temp-release
  pushd temp-release > /dev/null
  unzip ${ZIPARCHIVE} > /dev/null
  export OJBIN=`pwd`
  OJ="$OJBIN"/openjml
  JV="$OJBIN"/openjml-java
  RT="$OJBIN"/jmlruntime.jar
  echo Testing release build unzipped from $ZIPARCHIVE into `pwd`
  popd > /dev/null
fi


if [ ! -e "$OJ" ]; then
   echo No openjml : $OJ
   exit 1
fi

cd $LOCAL

## Currently in .../OpenJMLTest/release-tests
export RTH=$LOCAL/releaseTestHelper
RES=0


## Checks the version
echo Visually check that the version matches the zip file being tested
$OJ -version
echo "openjml" `cat $LOCAL/../../version.txt` > ${LOCAL}/testJmlVersion/expected
${RTH} testJmlVersion "$OJ -version" || RES=$(($RES+1))


## Checks the help message (when there are no arguments)
${RTH} testJmlHelpSimp "$OJ" || RES=$(($RES+1))

## Checks the help message (when there is a -? option)
${RTH} testJmlHelp "$OJ -?" || RES=$(($RES+1))

## Checks the help message (when there is a --help option)
${RTH} testJmlHelp "$OJ --help" || RES=$(($RES+1))

## Checks the help message (when there is a -help option)
${RTH} testJmlHelp "$OJ -help" || RES=$(($RES+1))

## Checks when there is a default verboseness argument
${RTH} testJmlBadNoSource "$OJ --verboseness=" || RES=$(($RES+1))

## Checks when there is a bad verboseness argument
${RTH} testJmlBadNoValue "$OJ --verboseness" || RES=$(($RES+1))

## Checks when there is a bad verboseness argument ## FIXME - embedded quotes are not working as expected within the test script
##${RTH} testJmlBadArg "$OJ --verboseness \"\"" || RES=$(($RES+1))

## Checks when there is a default verboseness argument
${RTH} testJmlBadNoSource "$OJ --verboseness= " || RES=$(($RES+1))

## Checks when there is a bad verboseness argument ## FIXME _ this works OK but not within this test script
#${RTH} testJmlBadArg "$OJ '-verboseness= '" || RES=$(($RES+1))

## Checks when there is a bad verboseness property
export OPENJML_verboseness=x
${RTH} testJmlBadProperty "$OJ -check" || RES=$(($RES+1))
unset OPENJML_verboseness

## Checks when there is a bad verboseness property
echo "org.openjml.option.verboseness=x" > ./openjml.properties
${RTH} testJmlBadProperty "$OJ -check" || RES=$(($RES+1))
rm openjml.properties

## Checks when there is a bad use of -java
${RTH} testJmlBadJava "$OJ -check -java" || RES=$(($RES+1))


