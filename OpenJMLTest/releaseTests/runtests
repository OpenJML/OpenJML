${RTH} testPath8 "$OJ -jmltesting ./src/testPath/data/TestPath.java -classpath ./src/testPath/data-specs${Z}./src/testPath/data " || RES=$(($RES+1))

## Checks using class path (java then specs) - finds super class; uses jml file for specs
${RTH} testPath9 "$OJ -jmltesting ./src/testPath/data/TestPath.java -classpath ./src/testPath/data${Z}./src/testPath/data-specs" || RES=$(($RES+1))

