${RTH} testPath10 "$OJ -jmltesting ./src/testPath/data/TestPath.java -classpath ./src/testPath/data --specs-path ./src/testPath/data-specs" || RES=$(($RES+1))


## Checks an invalid file
${RTH} testCheck1 "$OJ -jmltesting --specs-path src ./src/A.java" || RES=$(($RES+1))

echo Testing testAPI
../releaseTests/testAPI/run &> ../releaseTests/testAPI/actual
