java -ea -classpath "rac${Z}${RT}" -Dorg.jmlspecs.openjml.rac=javaassert A 1 2 > racactual  2> racstderr
tr -d '\r' < racactual | sed -e 'sx\\x/xg' |  diff - ../releaseTests/testRac/expected-start || { RES=$(($RES+1)); }
diff racstderr ../releaseTests/testRac/expected-javaassertenabled  || { RES=$(($RES+1)); }
echo RAC-AE
java -classpath "rac${Z}${RT}" -Dorg.jmlspecs.openjml.rac=assertionerror A 1 2 > racactual  2> racstderr
tr -d '\r' < racactual | sed -e 'sx\\x/xg' |  diff - ../releaseTests/testRac/expected-start || { RES=$(($RES+1)); }
diff racstderr ../releaseTests/testRac/expected-assertionerror  || { RES=$(($RES+1)); }
echo RAC-ST
java -classpath "rac${Z}${RT}" -Dorg.jmlspecs.openjml.rac=showstack A 1 2 > racactual  2> racstderr
tr -d '\r' < racactual | sed -e 'sx\\x/xg' |  diff - ../releaseTests/testRac/expected-stack || { RES=$(($RES+1)); }
diff racstderr ../releaseTests/testRac/expected-empty  || { RES=$(($RES+1)); }
echo RAC-ST with openjml-java
${JV} -classpath "rac" -Dorg.jmlspecs.openjml.rac=showstack A 1 2 > racactual  2> racstderr
tr -d '\r' < racactual | sed -e 'sx\\x/xg' |  diff - ../releaseTests/testRac/expected-stack-openjml || { RES=$(($RES+1)); }
diff racstderr ../releaseTests/testRac/expected-empty  || { RES=$(($RES+1)); }

${RTH} testRac "$OJ -rac --rac-show-source=source -d rac -classpath ./src/testRac --specs-path ./src/testRac ./src/testRac/A.java" || { RES=$(($RES+1)); }
echo RAC-SIMPLE with source
java -classpath "rac${Z}${RT}" A 1 2  > racactual
tr -d '\r' < racactual | sed -e 'sx\\x/xg' | diff - ../releaseTests/testRac/expected-simple-source || { RES=$(($RES+1)); }

