#! /usr/bin/env bash

## This script tests the behavior of the -d option for --show=json and --show=typedjson

## Might have trouble with symbolic links
cd $(dirname "${BASH_SOURCE[0]}")

ERR=0

rm -rf *.json
openjml --show=json *.java
for f in *.java ; do
  diff $f.json $f.json.expected || ERR=1
done

rm -rf *.json
openjml --show=json -d - *.java > out
cat Test*.json.expected | diff - out

rm -rf *.json out xx
openjml --show=json -d xx/yy *.java
diff xx/yy/Test.java.json Test.java.json.expected || ERR=1
diff xx/yy/p/TestP.java.json TestP.java.json.expected || ERR=1
diff xx/yy/q/r/TestPP.java.json TestPP.java.json.expected || ERR=1
echo "xxx" >> xx/yy/Test.java.json
# repeat without deleting files
openjml --show=json -d xx/yy *.java
diff xx/yy/Test.java.json Test.java.json.expected || ERR=1
diff xx/yy/p/TestP.java.json TestP.java.json.expected || ERR=1
diff xx/yy/q/r/TestPP.java.json TestPP.java.json.expected || ERR=1

## Typed AST

rm -rf *.json
openjml --show=typedjson *.java
diff A.json A.json.expected || ERR=1
diff C.json C.json.expected || ERR=1
diff CC.json CC.json.expected || ERR=1
diff CCC.json CCC.json.expected || ERR=1

rm -rf *.json
openjml --show=typedjson -d - *.java > out
( cat [AC]*.expected | diff - out ) || ERR=1

rm -rf *.json out xx
openjml --show=typedjson -d xx/yy *.java
diff xx/yy/A.json A.json.expected || ERR=1
diff xx/yy/C.json C.json.expected || ERR=1
diff xx/yy/p/CC.json CC.json.expected || ERR=1
diff xx/yy/q/r/CCC.json CCC.json.expected || ERR=1
echo "xxx" >> xx/yy/Test.java.json
# repeat without deleting files
openjml --show=typedjson -d xx/yy *.java
diff xx/yy/A.json A.json.expected || ERR=1
diff xx/yy/C.json C.json.expected || ERR=1
diff xx/yy/p/CC.json CC.json.expected || ERR=1
diff xx/yy/q/r/CCC.json CCC.json.expected || ERR=1

if [ $ERR == 1 ]; then echo "JSON LOCATION TESTS FAILED "; fi
exit $ERR
