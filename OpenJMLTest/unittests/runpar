#! /bin/bash

## This script runs all the unittests, running each testsuite (with all of its testcases) sequentially,
## but executing various testsuites concurrently. The number of concurrent jobs can be set by
## executing the script as 'JOBS=n ./runpar' for a particular number 'n' (default is 5)
## If there are command-line arguments, they must be a list of
## specific testsuites to run. If the number of permitted JOBS is 0, then the testsuites are run
## sequentially, without spawning any subprocesses.

## The tests within a test suite are run sequentially (controlled by THREADS, but see comments in OpenJMLTestRunner).

## If the environmental variable COV is set, then coverage measurements are reported

trap ctrl_c INT

function ctrl_c() {
    rm -f the.jml.lock unittestframework
#    echo $$ `ps | egrep '(unittests|summary|runtests)' | grep -v grep | awk '{ print $1}'`
#    kill  $$ `ps | egrep '(unittests|summary|runtests)' | grep -v grep | awk '{ print $1}'`
#    sleep 1
#    ps
#    kill $$ `ps | egrep '[unittests|summary|runtests]' | grep -v grep | awk '{ print $1}'`
#    #pkill -9 -P $$
    echo Aborted
    exit 1
}

echo START `date`
cd "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
rm -f the.jml.lock unittestframework

shopt -s expand_aliases

if [ -z "$JOBS" ]; then
    numjobs=5
else
    numjobs=$JOBS
fi

if [ "$1" == "-retrylog" ]; then OPT=$1 ; shift; fi

make -C .. prep

alias lsc="jobs | wc -l"
alias wtv="while [ \$(lsc) -ge $numjobs ]; do echo Waiting \$(lsc); sleep 10; done; echo proceeding \$(lsc)"
alias wt="while [ \$(lsc) -ge $numjobs ]; do sleep 10; done"

if [ -z "$*" ]; then
    if [ -n "$START" ]; then
        testlist=$(cd ../src/org/jmlspecs/openjmltest/testsuites ; ls *.java | tail -n +$START | head -n $LINES | sed -e 's/\.java//')
    else 
        testlist=$(cd ../src/org/jmlspecs/openjmltest/testsuites ; ls *.java | sed -e 's/\.java//')
        ## A full run: remove all old logs, including those of suites that no longer exist,
        ## so that retry sees only this run's results
        rm -f log-*
    fi
else
    testlist=$@
fi

for d in $testlist; do rm -f log-${d%.java}; done

RUNERR=0
if [ $numjobs -eq 0 ]; then
    echo Running $(echo $testlist | wc -w) testsuites sequentially
    sync
    for d in $testlist; do
        nm=${d%.java}
        #echo Starting $nm
        ./run-summary log-$nm $nm || RUNERR=1
    done
else
    echo Running $(echo $testlist | wc -w) testsuites with $numjobs concurrent jobs
    sync
    pids=()
    for d in $testlist; do
        nm=${d%.java}
        #echo Starting $nm
        ./run-summary log-$nm $nm &
        pids+=($!)
        sleep 1
        wt
    done
    for pid in "${pids[@]}"; do
        wait "$pid" || RUNERR=1
    done
fi
echo Completed
sync
## Per-test coverage (make cov-test-by-test): no retries. A retry runs a test a second time,
## in another JVM, which would add that run's coverage to the test's file and a second row to
## the index -- and the retry list also takes in failures from other suites' old log files.
if [ -n "${COV_BY_TEST++}" ]; then
    echo "Per-test coverage: retries skipped"
    echo END `date`
    exit $RUNERR
fi
set -o pipefail
echo MID `date`
./retry -run  2>&1 | tee logretry | grep --line-buffered -E 'Retrying|FAILED|Unexpected|TIMEOUT|timeout' 
ERR=$?
if [ $ERR -eq 0 ]; then 
    echo Completed all retrys successfully
else
    echo Completed retrys with remaining failures
    if [ -n "$OPT" ]; then cat logretry ; fi
    grep -E 'FAILED' logretry
    FAILURES=`grep -E 'FAILED' logretry | sed -e 's/^.*testsuites.//' | sort -u`
    echo "LIST:" $FAILURES
    echo "Second round retrys"
    runtests $FAILURES 2>&1 | tee logretry | grep  --line-buffered -E 'Retrying|FAILED|Unexpected|TIMEOUT|timeout'
    ERR=$?
    if [ $ERR -eq 0 ]; then 
        echo Completed all retrys successfully
    else
        echo Completed retrys with remaining failures
        if [ -n "$OPT" ]; then cat logretry ; fi
        grep -E 'FAILED' logretry
        FAILURES=`grep -E 'FAILED' logretry | sed -e 's/^.*testsuites.//' | sort -u`
        echo "LIST:" $FAILURES
    fi
fi
echo END `date`
exit $(( ERR || RUNERR ))
