#! /bin/bash

## This script runs all the unittests, running each testcase (with all of its subsidiaary tests) individually,
## but executing various testcases concurrently. The number of concurrent jobs can be set by
## executing the script as 'THREADS=n ./runpar' for a particular number 'n' (default is 5)
## If there are command-line arguments, they must be a list of
## specific testcases to run

## If the environmental variable COV is set, then coverage measurements are reported

shopt -s expand_aliases

if [ -z "$THREADS" ]; then
    numthreads=5
else
    numthreads=$THREADS
fi

cd $(dirname "$BASH_SOURCE")

#alias lsc="ps au | grep summary | grep -v grep | awk '{ print \$13 }' | sort -u | wc -l"
alias lsc="jobs | wc -l"
alias wtv="while [ \$(lsc) -ge $numthreads ]; do echo Waiting \$(lsc); sleep 30; done; echo proceeding \$(lsc)"
alias wt="while [ \$(lsc) -ge $numthreads ]; do sleep 30; done"

if [ -z "$*" ]; then
    testlist=`(cd ../src/org/jmlspecs/openjmltest/testcases ; ls *.java | sed -e 's/.java//')`
    rm -rf log-*
else
    testlist=$@
    for d in $testlist; do rm -f log-$d; done
fi

for d in $testlist; do
   ./run-summary log-$d $d & 
   wt
done
wait
echo Completed
