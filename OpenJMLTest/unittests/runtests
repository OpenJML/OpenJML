#! /bin/bash

## This script runs the JUnit tests (directly, without using Eclipse)
## It does so by running the OpenJMLTestRunner.java program, which is an OpenJML_specific
## JUnit-test runner, after compiling all the
## unit test drivers in OpenJMLTest/src/org/jmlspecs/openjmltest/testcases/

## If the environmental variable COV is set, then coverage measurements are reported, and
## are stored in the one coverage data file 'unit-$1' where $1 is the name of the first testsuite listed in the command-line

## $R is the location of the directory containing this script, with
## $R/.. expected to be OpenJMLTest, which should be a sibling of OpenJMLsrc

trap ctrl_c INT

function ctrl_c() {
    rm -f the.jml.lock unittestframework
    echo Aborted
    exit 1
}

F=$(realpath "$BASH_SOURCE")
R=$(dirname "$F")
export ROOT=$(cd "$R/../../OpenJMLsrc" && pwd -P)
JROOT="$R/../libs"

## On Windows (WSL) the built JDK is a Windows program (java.exe): it needs Windows paths, ';' between
## classpath entries, and WSLENV to see the environment variables set here (as in setup-vars)
if grep -qi microsoft /proc/version 2>/dev/null; then
    EXE=".exe"; S=";"
    function wp() { wslpath -w "$1"; }
else
    EXE=""; S=":"
    function wp() { echo "$1"; }
fi

JUNIT=""
for j in junit-4.13.2 hamcrest-core-1.3 junit-jupiter-api-5.5.2 apiguardian-api-1.1.0 opentest4j-1.3.0; do
    JUNIT="$JUNIT${JUNIT:+$S}$(wp "$JROOT/$j.jar")"
done
export NJAVAC=$(echo "$ROOT"/build/*/jdk/bin/javac$EXE)
NJAVA=$(echo "$ROOT"/build/*/jdk/bin/java$EXE)
export MODPATH=$(wp "$(echo "$ROOT"/build/*-release/jdk/modules)")

if [ $# -lt 1 ]; then
    echo "error: runtests requires at least one testsuite name"
    exit 1
fi

cd "$R"
## Now in OpenJMLTest/unittests

. "../setup-coverage" "unit-$1"

. "$ROOT/setup-exports"

rm -f *.class
CL=""
for m in $(echo "$ROOT"/build/*/jdk/modules/* | tr ' ' '\n' | grep -v META); do CL="$CL${CL:+$S}$(wp "$m")"; done
export CP=".$S../src$S$JUNIT$S$CL"

while true; do
  if make -q unittestframework ; then break; fi  ## make is up to date so go on to execute the compiled program

  if ! (( set -o noclobber; echo x > the.jml.lock ) &> /dev/null ) ; then echo "Waiting for the.jml.lock" ; sleep 3; continue; fi ## Check until the temp file does not exist

  ## Have the lock and last I checked the make was not up to date, so do the compile

  ## Use make instead of the explicit compile to use make's up-to-date-ness checking
  ## Make needs NJAVAC CP OPENJML_EXPORTS ROOT (hence these are exported)
  echo Compiling for $@
  make unittestframework

  rm -f the.jml.lock ## Release the lock

  echo Compilation complete
  break
done

SPECS=$(cd "$ROOT/../../Specs/specs" && pwd -P)
## Now run the compiled Test program -- stdout and stderr output are combined into one output
## (COV_MAIN_AGENT is set only for per-test coverage -- see setup-coverage)
## This almost duplicates running openjml-java in the development environment, except for the addition of AGENT and the specific classpath
## echo Running $@
#( "$ROOT"/openjml-java $AGENT  -cp "unittests:src:$JUNIT" $OPENJML_EXPORTS org.openjml.runners.OpenJMLTestRunner "$@" 2>&1 )
## On WSL, the /p flag has WSL translate these Linux paths for java.exe
if [ -n "$EXE" ]; then export WSLENV="${WSLENV:+$WSLENV:}OPENJML_INSTALL/p:OPENJML_SPECS/p:SMT_SOLVER_DIR/p"; fi
function run_tests() {
    ( cd ..; OPENJML_INSTALL="$ROOT" SMT_SOLVER_DIR="${SMT_SOLVER_DIR:-$ROOT/../../Solvers/Solvers-$("$ROOT"/os-name.sh)}" OPENJML_SPECS="$SPECS" "$NJAVA" "--patch-module=jdk.compiler=$(wp "$ROOT/libs/jSMTLIB.jar")" ${COV_MAIN_AGENT:-$OPENJML_JVM} -cp "src$S$JUNIT" $OPENJML_EXPORTS org.openjml.runners.OpenJMLTestRunner "$@" 2>&1 )
}
## On WSL, java.exe ends lines with CRLF; drop the CRs so that logs and test names compare as on other platforms
if [ -n "$EXE" ]; then set -o pipefail; run_tests "$@" | tr -d '\r'; else run_tests "$@"; fi
