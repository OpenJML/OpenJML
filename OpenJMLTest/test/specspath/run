#! /usr/bin/env bash

LOCAL=$(dirname "$BASH_SOURCE[0]" )
. "$LOCAL/../setup-script"

OJA="openjml -cp . "

## P.java with specspath defaulting to current directory, so finds ./P.jml
## (a copy of P5 below; it cannot run in-process, since it depends on the current directory)
rm -rf actual; touch actual
echo Test P5 uses ./P.jml for specs >> actual
$OJA --esc pxsrc/P.java >> actual 2>&1
expected_output expected-P5 | diff - actual && rm -rf actual
exit $?

## For performance reasons, the rest of these tests run in-process as the escspecspath test suite
## (OpenJMLTest/src/org/jmlspecs/openjmltest/testsuites/escspecspath.java, expected outputs in
## OpenJMLTest/test/escspecspath/), which has more cases. They are kept here, with their expected
## outputs in 'expected', for reference or future reuse.

rm -rf `find . -name C.class` actual; touch actual;
$OJA --compile srct/C.java ; cp srct/C.class srctt/C.class ; cp srct/C.class srcta/C.class ; cp srct/C.class srctq/C.class
$OJA --compile srcz/z/C.java ; mkdir -p srczz/z; cp srcz/z/C.class srczz/z/C.class ; cp srcz/z/C.class srcza/z/C.class

## P.java with no specs at all
echo Test P1 uses ppsrc/P.java for specs >> actual
$OJA --esc ppsrc/P.java --specs-path specsempty >> actual 2>&1
## P.java with specs on specspath
echo Test P2 uses ppspecs/P.jml for specs >> actual
$OJA --esc ppsrc/P.java --specs-path ppspecs >> actual 2>&1
## P.java with sibling specs and nothing on specspath
echo Test P3 uses pxsrc/P.jml for specs >> actual
$OJA --esc pxsrc/P.java --specs-path specsempty >> actual 2>&1
## P.java with sibling specs and specs on specspath
echo Test P4 uses ppspecs/P.jml for specs >> actual
$OJA --esc pxsrc/P.java --specs-path ppspecs >> actual 2>&1
## P.java with specspath defaulting to current directory, so finds ./P.jml
echo Test P5 uses ./P.jml for specs >> actual
$OJA --esc pxsrc/P.java >> actual 2>&1

## B.java with no specs
echo Test B1 uses bbsrc/B.java  >> actual 2>&1
$OJA --esc AB.java --source-path bbsrc --specs-path specsempty >> actual 2>&1
## B.java with specs on specs path
echo Test B2 uses bbspecs/B.jml >> actual 2>&1
$OJA --esc AB.java --source-path bbsrc --specs-path bbspecs >> actual 2>&1
## B.java with no specs on specs path, but sibling specs
echo Test B3 uses bxsrc/B.jml >> actual 2>&1
$OJA --esc AB.java --source-path bxsrc --specs-path specsempty >> actual 2>&1
## B.java with specs on specs path and sibling specs
echo Test B4 uses bbspecs/B.jml >> actual 2>&1
$OJA --esc AB.java --source-path bxsrc --specs-path bbspecs  >> actual 2>&1
## B.java with specs path defaulting to sourcepath
echo Test B5 uses bxsrc/B.jml >> actual 2>&1
$OJA --esc AB.java --source-path bxsrc  >> actual 2>&1


## Referenced binary class with .class and .java and .jml
echo Test C1 -- should use ccspecs/C.jml >> actual 2>&1
$OJA --esc AC.java -cp srct --specs-path=ccspecs >> actual 2>&1
## Referenced binary class with .class and .java
echo Test C2 -- uses no specs for C, empty specs path, fails >> actual 2>&1
$OJA --esc AC.java -cp srct --specs-path=specsempty >> actual 2>&1
## Referenced binary class with .class and .java
echo Test C3 -- uses no specs for C, specs path defaults to srct, which has no C.jml, fails >> actual 2>&1
$OJA --esc AC.java -cp srct  >> actual 2>&1
## Referenced binary class with .class and .java and .jml
echo Test C3a -- uses srcta/C.jml, specs path defaults to srcta, succeeds >> actual 2>&1
$OJA --esc AC.java -cp srcta  >> actual 2>&1
## Referenced binary class with only a .class file
echo Test C4 -- should have a assignable verification failure >> actual 2>&1
$OJA --esc AC.java -cp srctt --specs-path=specsempty >> actual 2>&1

## Empty specs path, two .java on source path. second one on CL -- finds the .jml next to the used .java file
echo Test Y1 finds pxsrc/P.jml >> actual 2>&1
$OJA --esc --source-path=ppsrc:pxsrc --specs-path=specsempty pxsrc/P.java >> actual 2>&1
## Empty specs path, two .java on source path. second one on CL -- usese the CL .java file even though there is a .jml on the sourcepath
echo Test Y2 uses ppsrc/P.java >> actual 2>&1
$OJA  --esc --source-path=pxsrc:ppsrc --specs-path=specsempty ppsrc/P.java >> actual 2>&1


## Referenced binary class with .class and .java and .jml
echo Test Z1 uses ccspecs/z/C.jml >> actual 2>&1
$OJA --esc AZC.java -cp srcz --specs-path=ccspecs >> actual 2>&1
## Referenced binary class with .class and .java
echo Test Z2 -- uses no specs for C, empty specs path, fails >> actual 2>&1
$OJA --esc AZC.java -cp srcz --specs-path=specsempty >> actual 2>&1
## Referenced binary class with .class and .java
echo Test Z3 -- uses no specs for C, specs path defaults to srcz, which has no z/C.jml, fails >> actual 2>&1
$OJA --esc AZC.java -cp srcz >> actual 2>&1
## Referenced binary class with .class and .java and .jml
echo Test Z3a -- uses srcza/z/C.jml, specs path defaults to srcza, succeeds >> actual 2>&1
$OJA --esc AZC.java -cp srcza >> actual 2>&1
## Referenced binary class with only a .class file
echo Test Z4 -- should have an assignable problem >> actual 2>&1
$OJA --esc AZC.java -cp srczz --specs-path=specsempty >> actual 2>&1

expected_output expected | diff - actual && rm -rf actual
exit $?
