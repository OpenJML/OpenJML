#! /usr/bin/env bash

LOCAL=$(dirname "$BASH_SOURCE[0]" )
. "$LOCAL/../setup-script"

## The .jml of binary class A, a non-sealed subclass of sealed S: the class file does not record
## non-sealed, so the sealed-subclass check rejected A.
rm -rf actual bin
(openjml --compile -d bin src/p/*.java && openjml --check -cp bin --specs-path specs F.java) >& actual
expected_output expected | diff actual - && rm -rf actual bin
