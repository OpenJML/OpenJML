#! /usr/bin/env bash

cd $(dirname "$BASH_SOURCE[0]" )
BIN=../../../OpenJML21
if [ -z "$OJA" ]; then OJA=$BIN/openjml; fi

(\
rm -f *.class ;\
$OJA --rac T.java ;\
$OJA -Xprefer:source --compile P.java ;\
$BIN/openjml-java T ;\
) >& actual
diff actual RUN.out && rm -rf actual

(\
rm -f *.class ;\
$OJA --rac T.java P.java ;\
$BIN/openjml-java T ;\
) >& actual2
diff actual2 RUN2.out && rm -rf actual2
