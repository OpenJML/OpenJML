
## This file should be sourced, not executed
## as a helper to run files in the OpenJML tests

cd "$LOCAL"
BIN=../../../OpenJMLsrc
PATH=$BIN:$PATH
export REPO=`(cd ../../.. ; pwd)`   ## This checkout (usually named OpenJML)
export ROOT=`(cd ../../../.. ; pwd)` ## The folder containing it, Specs, Solvers, etc.
export SPECS=`(cd $ROOT/Specs/specs; pwd)`

## Prints the named expected-output file with $ROOT/OpenJML (this checkout), $ROOT and $SPECS replaced
expected_output() { sed -e "s%\$ROOT/OpenJML/%$REPO/%g" -e "s%\$ROOT%$ROOT%g" -e "s%\$SPECS%$SPECS%g" "$1"; }
