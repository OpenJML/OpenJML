#! /usr/bin/env bash

## Type-checks real-world library files that once drew spurious inference errors (#784)
LOCAL=$(dirname "$BASH_SOURCE[0]" )
. "$LOCAL/../setup-script"

CP=".$CPSEP"commons-collections4-4.5.0.jar

rm -rf actual

for f in src/*.java ; do
echo FILE $f >> actual 2>&1
openjml --check -cp $CP --nullable-by-default $f >> actual 2>&1
done

expected_output expected | diff actual - && rm -rf actual
