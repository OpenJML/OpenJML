#! /usr/bin/env bash

. ../setup-for-runscript
setup-for-runscript

ERR=0
(\
rm -f *.class ;\
$OJA --rac T.javaa ;\
$OJA -Xprefer:source --compile P.java ;\
$BIN/openjml-java T ;\
) >& actual
(diff actual RUN.out || ERR=1 ) && rm -rf actual

(\
rm -f *.class ;\
$OJA --rac T.java P.java ;\
$BIN/openjml-java T ;\
) >& actual2
(diff actual2 RUN2.out || ERR=1) && rm -rf actual2

exit $ERR
