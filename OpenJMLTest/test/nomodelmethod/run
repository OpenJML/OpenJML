#! /usr/bin/env bash

LOCAL=$(dirname "$BASH_SOURCE[0]" )
. "$LOCAL/../setup-script"

## Both runs are compared; the test fails if either differs
ERR=0
(\
rm -f *.class ;\
openjml --rac T.java ;\
openjml -Xprefer:source --compile P.java ;\
openjml-java T ;\
) >& actual
diff actual RUN.out && rm -rf actual || ERR=1

(\
rm -f *.class ;\
openjml --rac T.java P.java ;\
openjml-java T ;\
) >& actual2
diff actual2 RUN2.out && rm -rf actual2 || ERR=1

exit $ERR
