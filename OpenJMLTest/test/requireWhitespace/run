#! /bin/bash

cd $(dirname $BASH_SOURCE[0] )  
BIN=../../../OpenJML21
if [ -z "$OJA" ]; then OJA=$BIN/openjml; fi

(\
echo Test 1 ;\
$OJA --check --require-white-space Test.java ;\
echo Test 2 ;\
$OJA --check Test.java ;\
echo Test 3 ;\
$OJA --check --no-require-white-space Test.java ;\
) >& actual

diff expected actual && rm -rf actual
