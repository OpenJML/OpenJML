#! /usr/bin/env bash

LOCAL=$(dirname "$BASH_SOURCE[0]" )
. "$LOCAL/../setup-script"

(\
echo Test 1 ;\
$OJA --check --require-white-space Test.java ;\
echo Test 2 ;\
$OJA --check Test.java ;\
echo Test 3 ;\
$OJA --check --no-require-white-space Test.java ;\
) >& actual

diff expected actual && rm -rf actual
exit $?
