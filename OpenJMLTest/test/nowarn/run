#! /bin/bash

cd $(dirname "$BASH_SOURCE[0]" )
BIN=../../../OpenJML21
if [ -z "$OJA" ]; then OJA=$BIN/openjml ; fi

(\
echo Test 1 ;\
$OJA --check D.java ; \
echo EXIT $? ;\
echo Test 2; \
$OJA --check -Xlint:all D.java ;\
echo EXIT $? ;\
echo Test 3; \
$OJA --check -Xlint:all -nowarn D.java ;\
echo EXIT $? ;\
echo Test 4; \
$OJA --check -Xlint:all -Werror -nowarn D.java ; \
echo EXIT $? ;\
echo Test 5; \
$OJA --check -Xlint:all -Werror D.java ; \
echo EXIT $? ;\
) >& actual

(\
echo Test 1 ;\
$OJA --check K.java ; \
echo EXIT $? ;\
echo Test 2; \
$OJA --check -Xlint:all K.java ;\
echo EXIT $? ;\
echo Test 3; \
$OJA --check -Xlint:all -nowarn K.java ;\
echo EXIT $? ;\
echo Test 4; \
$OJA --check -Xlint:all -Werror -nowarn K.java ; \
echo EXIT $? ;\
echo Test 4a; \
$OJA --check -nowarn -Xlint:all -Werror K.java ; \
echo EXIT $? ;\
echo Test 5; \
$OJA --check -Xlint:all -Werror K.java ; \
echo EXIT $? ;\
) >> actual 2>&1

## Test that -Xlint works
(\
echo Test -Xlint; \
$OJA --check -Xlint:text-blocks TB.java ;\
echo Test -Xlint off ;\
$OJA --check TB.java ;\
) >> actual 2>&1

diff actual expected && rm -rf actual

