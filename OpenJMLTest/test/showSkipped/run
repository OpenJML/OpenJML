#! /usr/bin/env bash

LOCAL=$(dirname "$BASH_SOURCE[0]" )
. "$LOCAL/../setup-script"

(\
echo Test 0 ;\
openjml -jmltesting --esc --normal Test.java ;\
echo Test 1 ;\
openjml -jmltesting --esc --progress Test.java ;\
echo Test 2 ;\
openjml -jmltesting --esc --progress --method=m,n,z --exclude=z --show-skipped Test.java ;\
echo Test 3 ;\
openjml -jmltesting --esc --progress --no-show-skipped Test.java ;\
) >& actual 

diff expected actual && rm -rf actual
exit $?
