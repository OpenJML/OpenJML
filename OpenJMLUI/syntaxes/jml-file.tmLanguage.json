{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "JML",
  "scopeName": "source.jml",
  "fileTypes": ["jml"],
  "patterns": [
    { "include": "#jml-line-comment" },
    { "include": "#jml-block-comment" },
    { "include": "source.java" }
  ],
  "repository": {
    "jml-line-comment": {
      "comment": "JML line annotation: //@ ... or conditional line annotations",
      "begin": "//([\\+\\-][a-zA-Z_][a-zA-Z0-9_]*)*@",
      "end": "$",
      "name": "comment.line.jml",
      "patterns": [
        { "include": "#jml-backslash" },
        { "include": "#jml-keywords" }
      ]
    },
    "jml-block-comment": {
      "comment": "JML block annotation: /*@ ... */ or conditional block annotations",
      "begin": "/\\*([\\+\\-][a-zA-Z_][a-zA-Z0-9_]*)*@",
      "end": "@?\\*/",
      "name": "comment.block.jml",
      "patterns": [
        { "include": "#jml-backslash" },
        { "include": "#jml-keywords" }
      ]
    },
    "jml-keywords": {
      "comment": "JML clause and modifier keywords — keep in sync with JmlKeywords.JML_KEYWORDS in OpenJMLlsp/src/org/openjml/lsp/JmlKeywords.java",
      "name": "keyword.other.jml",
      "match": "\\b(requires|ensures|signals|signals_only|assignable|modifies|accessible|callable|measured_by|captures|diverges|when|working_space|duration|breaks|continues|returns|invariant|initially|constraint|represents|axiom|readable|writable|also|implies_that|for_example|example|pure|ghost|model|spec_public|spec_protected|spec_private|non_null|nullable|helper|instance|query|secret|no_state|two_state|monitored|uninitialized|loop_invariant|maintaining|decreasing|decreases|assume|assert|set|debug|hence_by|unreachable|reachable|in|maps|forall|exists|min|max|sum|product|num_of|let|old|pre|result|not_modified)\\b"
    },
    "jml-backslash": {
      "comment": "JML backslash-expressions — keep in sync with JmlKeywords.JML_BACKSLASH in OpenJMLlsp/src/org/openjml/lsp/JmlKeywords.java",
      "name": "variable.language.jml",
      "match": "\\\\(result|old|pre|fresh|reach|forall|exists|min|max|sum|product|num_of|nothing|everything|not_specified|typeof|type|elemtype|lockset|nonnullelements|invariant_for|is_initialized|duration|space|working_space|values|index|indices|not_modified|only_accessed|only_assigned|only_called|only_captured|exception|witness|empty|singleton)\\b"
    }
  }
}
