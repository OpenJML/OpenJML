Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: OpenJMLUI
Bundle-SymbolicName: org.openjml.OpenJMLUI;singleton:=true
Bundle-Version: 0.21.0
Bundle-ClassPath: .
Bundle-Activator: org.openjml.ui.Activator
Export-Package: org.jmlspecs.openjml.eclipse,
 org.jmlspecs.openjml.eclipse.widgets,
 org.openjml.ui
Require-Bundle: org.eclipse.ui,
 org.eclipse.core.runtime,
 org.eclipse.jdt.core,
 org.eclipse.core.resources;bundle-version="3.4.2",
 org.eclipse.ui.console;bundle-version="3.3.1",
 org.eclipse.ui.ide,
 org.eclipse.jdt.ui;bundle-version="3.4.2";visibility:=reexport,
 org.eclipse.jface.text;bundle-version="3.4.2",
 org.eclipse.lsp4e,
 org.eclipse.lsp4j,
 org.eclipse.lsp4j.jsonrpc,
 org.eclipse.core.filebuffers,
 org.eclipse.tm4e.registry;resolution:=optional,
 org.eclipse.ui.workbench.texteditor,
 org.eclipse.search,
 org.eclipse.ui.genericeditor;bundle-version="1.3.600",
 org.eclipse.ui.views
Import-Package: org.eclipse.ui.texteditor,
 org.osgi.framework.wiring
Automatic-Module-Name: org.openjml.openjmlui
Bundle-ActivationPolicy: lazy
Bundle-RequiredExecutionEnvironment: JavaSE-21
